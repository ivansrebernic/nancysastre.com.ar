---
import Icon from './Icon.astro';
---

<section id="contact-wrap" class="py-12 md:py-20 bg-primary-light">
  <div class="container-narrow">
    <!-- Section Header -->
    <div id="contact-intro" class="text-center max-w-2xl mx-auto mb-8">
      <p class="section-title">ÚLTIMO PASO</p>
      <h3 class="section-heading mb-4">Coordiná tu entrevista personalizada</h3>
      <p class="text-primary-dark/70">
        Si querés evaluar la viabilidad de sumarte a Fuxion, completá el formulario a continuación.
        Tus respuestas me permiten preparar una entrevista a la medida de tu perfil y tus objetivos.
      </p>
    </div>

    <!-- Qualifying Form -->
    <div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-soft p-6 md:p-10">
      <form
        id="contact-form"
        class="space-y-6"
        method="POST"
        action="https://formsubmit.co/nancyloschalets@gmail.com"
      >
        <!-- FormSubmit Configuration -->
        <input type="hidden" name="_subject" value="Nueva solicitud de entrevista - Microfranquicia Digital" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="text" name="_honey" style="display:none" />
        <input type="hidden" name="type" value="entrevista" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Name -->
          <div>
            <label for="name" class="block text-sm uppercase tracking-wider mb-2 text-primary-dark/60">Nombre</label>
            <input
              type="text"
              id="name"
              name="Nombre"
              placeholder="Tu nombre"
              required
              class="w-full px-4 py-3 bg-sage/60 border border-primary-dark/15 rounded-xl text-primary-dark placeholder-primary-dark/40 focus:border-primary focus:outline-none transition-all duration-300 hover:border-primary/40"
            />
          </div>

          <!-- Email -->
          <div>
            <label for="email" class="block text-sm uppercase tracking-wider mb-2 text-primary-dark/60">Email</label>
            <input
              type="email"
              id="email"
              name="Email"
              placeholder="tucorreo@ejemplo.com"
              required
              class="w-full px-4 py-3 bg-sage/60 border border-primary-dark/15 rounded-xl text-primary-dark placeholder-primary-dark/40 focus:border-primary focus:outline-none transition-all duration-300 hover:border-primary/40"
            />
          </div>

          <!-- WhatsApp -->
          <div>
            <label for="whatsapp" class="block text-sm uppercase tracking-wider mb-2 text-primary-dark/60">WhatsApp</label>
            <input
              type="tel"
              id="whatsapp"
              name="WhatsApp"
              placeholder="+54 9 ..."
              required
              class="w-full px-4 py-3 bg-sage/60 border border-primary-dark/15 rounded-xl text-primary-dark placeholder-primary-dark/40 focus:border-primary focus:outline-none transition-all duration-300 hover:border-primary/40"
            />
          </div>

          <!-- Country -->
          <div>
            <label for="pais" class="block text-sm uppercase tracking-wider mb-2 text-primary-dark/60">País de residencia</label>
            <input
              type="text"
              id="pais"
              name="Pais de residencia"
              placeholder="Tu país"
              required
              class="w-full px-4 py-3 bg-sage/60 border border-primary-dark/15 rounded-xl text-primary-dark placeholder-primary-dark/40 focus:border-primary focus:outline-none transition-all duration-300 hover:border-primary/40"
            />
          </div>
        </div>

        <!-- Q1: Perfil -->
        <div>
          <label for="perfil" class="block text-sm uppercase tracking-wider mb-2 text-primary-dark/60">¿Cuál es tu perfil actual?</label>
          <select
            id="perfil"
            name="Perfil actual"
            required
            class="w-full px-4 py-3 bg-sage/60 border border-primary-dark/15 rounded-xl text-primary-dark focus:border-primary focus:outline-none transition-all duration-300 hover:border-primary/40"
          >
            <option value="" disabled selected>Seleccioná una opción</option>
            <option>Profesional de la salud / Bienestar</option>
            <option>Emprendedor / Comerciante / Dueño de negocio</option>
            <option>Creador de contenido / Influencer</option>
            <option>Busco mi primer emprendimiento digital / Manejo del hogar</option>
          </select>
        </div>

        <!-- Q2: Tiempo semanal -->
        <div>
          <label for="tiempo" class="block text-sm uppercase tracking-wider mb-2 text-primary-dark/60">¿Cuánto tiempo semanal dispones para desarrollar tu microfranquicia?</label>
          <select
            id="tiempo"
            name="Tiempo semanal disponible"
            required
            class="w-full px-4 py-3 bg-sage/60 border border-primary-dark/15 rounded-xl text-primary-dark focus:border-primary focus:outline-none transition-all duration-300 hover:border-primary/40"
          >
            <option value="" disabled selected>Seleccioná una opción</option>
            <option>De 2 a 5 horas semanales (Como ingreso extra)</option>
            <option>De 5 a 12 horas semanales (Enfoque de crecimiento rápido)</option>
            <option>Más de 12 horas (Dedicación exclusiva)</option>
          </select>
        </div>

        <!-- Q3: Objetivo -->
        <div>
          <label for="objetivo" class="block text-sm uppercase tracking-wider mb-2 text-primary-dark/60">¿Cuál es tu principal objetivo al postularte a esta entrevista?</label>
          <select
            id="objetivo"
            name="Objetivo principal"
            required
            class="w-full px-4 py-3 bg-sage/60 border border-primary-dark/15 rounded-xl text-primary-dark focus:border-primary focus:outline-none transition-all duration-300 hover:border-primary/40"
          >
            <option value="" disabled selected>Seleccioná una opción</option>
            <option>Conocer cómo generar ingresos residuales en dólares/euros desde mi país.</option>
            <option>Aprender a usar sistemas digitales y automatizados aplicados al bienestar.</option>
            <option>Diversificar mis ingresos actuales sin descuidar mi profesión.</option>
          </select>
        </div>

        <!-- Flash Messages -->
        <div id="flash-message" class="flashinfo hidden bg-white px-12 py-4 rounded relative border border-gray-200">
          <span class="material-icons absolute left-4 top-1/2 transform -translate-y-1/2 text-primary"></span>
          <span class="message-text"></span>
        </div>

        <!-- Submit -->
        <div class="text-center">
          <button
            type="submit"
            class="btn-primary px-12 py-4 font-scandia-medium tracking-wider hover:shadow-large transform hover:scale-105 transition-all duration-300"
            id="submit-btn"
          >
            <span class="relative z-10">QUIERO MI ENTREVISTA</span>
          </button>
          <p class="text-xs text-primary-dark/50 mt-4">
            Cupo medido de incorporaciones mensuales · Respuesta en menos de 48 hs
          </p>
        </div>
      </form>

      <!-- Estado post-conversión: reemplaza al formulario una vez enviado.
           Es el momento de máxima intención — damos el próximo paso concreto
           en vez de un flash message que desaparece. -->
      <div id="form-success" class="hidden text-center">
        <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-6">
          <span class="material-icons text-primary text-4xl">check</span>
        </div>

        <h3 class="section-heading mb-3">
          ¡Listo<span id="success-name"></span>! Recibí tu solicitud
        </h3>
        <p class="text-primary-dark/70 max-w-md mx-auto mb-8">
          Voy a revisar tus respuestas para preparar la entrevista a la medida de tu perfil.
        </p>

        <ol class="text-left max-w-md mx-auto space-y-4 mb-8">
          <li class="flex gap-4">
            <span class="font-fraunces font-semibold text-primary/40 text-xl leading-none pt-0.5">1</span>
            <p class="text-primary-dark/75 text-sm leading-relaxed">
              Reviso tu perfil y tus objetivos personalmente.
            </p>
          </li>
          <li class="flex gap-4">
            <span class="font-fraunces font-semibold text-primary/40 text-xl leading-none pt-0.5">2</span>
            <p class="text-primary-dark/75 text-sm leading-relaxed">
              Te escribo por WhatsApp en menos de 48 hs con día y horario propuestos.
            </p>
          </li>
          <li class="flex gap-4">
            <span class="font-fraunces font-semibold text-primary/40 text-xl leading-none pt-0.5">3</span>
            <p class="text-primary-dark/75 text-sm leading-relaxed">
              Tenemos la entrevista: 30 minutos, sin compromiso, para ver si el modelo encaja con vos.
            </p>
          </li>
        </ol>

        <div class="border-t border-primary-dark/10 pt-8">
          <p class="text-sm text-primary-dark/70 mb-4">¿No querés esperar? Escribime ahora.</p>
          <a
            id="success-whatsapp"
            href="https://wa.me/5492994651620"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary inline-flex items-center justify-center gap-2 px-8 py-3"
          >
            <Icon name="whatsapp" />
            HABLEMOS POR WHATSAPP
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  input:focus,
  select:focus {
    background-color: #ffffff;
    box-shadow: 0 4px 20px rgba(46, 94, 65, 0.15);
  }

  input,
  select {
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .flashinfo {
    transition: all 0.3s ease;
  }

  .flashinfo.show {
    display: block;
    animation: slideIn 0.3s ease-out;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  import { track, trackMeta } from '../lib/analytics';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const flashMessage = document.getElementById('flash-message');
  const messageText = flashMessage?.querySelector('.message-text');
  const messageIcon = flashMessage?.querySelector('.material-icons');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const contactIntro = document.getElementById('contact-intro');
  const successPanel = document.getElementById('form-success');
  const successName = document.getElementById('success-name');
  const successWhatsapp = document.getElementById('success-whatsapp') as HTMLAnchorElement;

  const WHATSAPP_NUMBER = '5492994651620';

  /** Swaps the form for the next-step panel: the post-submit moment is peak intent. */
  function showSuccessPanel(name: string) {
    const firstName = name.trim().split(/\s+/)[0] || '';

    if (successName && firstName) successName.textContent = `, ${firstName}`;

    if (successWhatsapp) {
      const message = `Hola Nancy! Soy ${name.trim() || 'una persona interesada'}, acabo de completar el formulario para la entrevista.`;
      successWhatsapp.href = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
    }

    form?.classList.add('hidden');
    contactIntro?.classList.add('hidden');
    successPanel?.classList.remove('hidden');
    successPanel?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  successWhatsapp?.addEventListener('click', () => {
    track('whatsapp_click', { location: 'post_submit' });
  });

  function showMessage(message: string, type: 'success' | 'error' | 'loading') {
    if (!flashMessage || !messageText || !messageIcon) return;

    flashMessage.classList.remove('hidden', 'bg-white', 'bg-green-50', 'bg-red-50');
    flashMessage.classList.add('show');
    messageText.textContent = message;

    if (type === 'loading') {
      messageIcon.textContent = 'hourglass_bottom';
      flashMessage.classList.add('bg-white');
    } else if (type === 'success') {
      messageIcon.textContent = 'check_circle';
      messageIcon.classList.add('text-green-600');
      flashMessage.classList.add('bg-green-50', 'border-green-200');
    } else {
      messageIcon.textContent = 'error';
      messageIcon.classList.add('text-red-600');
      flashMessage.classList.add('bg-red-50', 'border-red-200');
    }
  }

  function hideMessage() {
    if (!flashMessage || !messageIcon) return;
    flashMessage.classList.add('hidden');
    flashMessage.classList.remove('show', 'bg-white', 'bg-green-50', 'bg-red-50', 'border-green-200', 'border-red-200');
    messageIcon.classList.remove('text-green-600', 'text-red-600');
  }

  // Track engagement so we can tell *where* people give up on the form.
  let formStarted = false;
  let formSubmitted = false;
  let lastField = '';

  form?.addEventListener('focusin', (e) => {
    const field = e.target as HTMLElement;
    if (field.matches('input, select, textarea')) {
      lastField = field.getAttribute('name') || field.id || '';
    }
    if (!formStarted) {
      formStarted = true;
      track('form_start', { form_id: 'contact-form' });
    }
  });

  // Started but never submitted, and now leaving the page = abandonment.
  // pagehide (not tab-switch) keeps this to genuine exits; gtag uses a
  // beacon so the event survives unload.
  window.addEventListener('pagehide', () => {
    if (!formStarted || formSubmitted) return;
    formSubmitted = true;
    track('form_abandon', { form_id: 'contact-form', last_field: lastField || 'none' });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);

    submitBtn.disabled = true;
    submitBtn.textContent = 'ENVIANDO...';
    showMessage('Por favor espera...', 'loading');

    try {
      const response = await fetch('https://formsubmit.co/ajax/nancyloschalets@gmail.com', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(Object.fromEntries(formData))
      });

      if (response.ok) {
        formSubmitted = true;
        track('generate_lead', { form_id: 'contact-form' });
        trackMeta('Lead', { content_name: 'entrevista_personalizada' });
        hideMessage();
        showSuccessPanel(String(formData.get('Nombre') ?? ''));
        form.reset();
      } else {
        track('form_error', { form_id: 'contact-form', reason: 'bad_response' });
        showMessage('Hubo un error al enviar el formulario. Por favor intentá de nuevo.', 'error');
      }
    } catch (error) {
      track('form_error', { form_id: 'contact-form', reason: 'network' });
      showMessage('Error de conexión. Verificá tu internet e intentá de nuevo.', 'error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'QUIERO MI ENTREVISTA';
      setTimeout(hideMessage, 6000);
    }
  });
</script>
